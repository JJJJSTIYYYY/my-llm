  "filter_driver_source": "import gc, json, statistics, time\nfrom my_llm.codec.converter import MyCodec\nfrom my_llm.codec.shared import transport\nfrom tests.performance.workloads import Size, build, profiles, controls\nfrom tests.helpers.protocols import PROTOCOLS\nfrom my_llm.profile.resolution import resolve_profiles\nfrom tests.performance.fingerprint import source, harness\nout={'source_sha256':source(), 'harness_sha256':harness(), 'cases':[]}\nfor proto in PROTOCOLS:\n    codec=MyCodec()\n    provider,model=profiles(proto)\n    profile=resolve_profiles(provider,model)\n    w=build(proto,proto,Size(),native=True)\n    encoded=codec.encode(w.messages,w.tools,input_format=proto)\n    native=codec.request(encoded,profile,**controls(proto))\n    decoder=codec.codecs[proto].decoder\n    for label,values,schema in [('messages',native[decoder.message_path[0]],decoder.message_type), ('tools',native.get('config',native).get('tools',[]),decoder.tool_type)]:\n        plan=transport._plan(schema)\n        for _ in range(10):\n            [plan.apply(v) for v in values]\n        samples=[]\n        for _ in range(31):\n            gc.collect()\n            start=time.perf_counter_ns()\n            for _ in range(20):\n                [plan.apply(v) for v in values]\n            samples.append((time.perf_counter_ns()-start)/20/1e6)\n        out['cases'].append({'protocol':proto,'kind':label,'samples_ms':samples,'median_ms':statistics.median(samples)})\nprint(json.dumps(out,indent=2))\n",
  "validation_driver_source": "import gc, json, statistics, time, tracemalloc\nfrom my_llm.codec.converter import MyCodec\nfrom my_llm.codec.shared import transport\nfrom tests.performance.workloads import Size, build, profiles, controls\nfrom tests.helpers.protocols import PROTOCOLS\nfrom my_llm.profile.resolution import resolve_profiles\nfrom tests.performance.fingerprint import source, harness\nout={'source_sha256':source(), 'harness_sha256':harness(), 'cases':[]}\nfor proto in PROTOCOLS:\n    codec=MyCodec()\n    provider,model=profiles(proto)\n    profile=resolve_profiles(provider,model)\n    w=build(proto,proto,Size(),native=True)\n    encoded=codec.encode(w.messages,w.tools,input_format=proto)\n    native=codec.request(encoded,profile,**controls(proto))\n    decoder=codec.codecs[proto].decoder\n    for label,values,schema in [('messages',native[decoder.message_path[0]],decoder.message_type), ('tools',native.get('config',native).get('tools',[]),decoder.tool_type)]:\n        plan=transport._plan(schema)\n        def check(values):\n            decoder.validate_values(values,schema,filtered=True)\n        for _ in range(10):\n            check(values)\n        samples=[]\n        for _ in range(31):\n            gc.collect()\n            start=time.perf_counter_ns()\n            for _ in range(20):\n                check(values)\n            samples.append((time.perf_counter_ns()-start)/20/1e6)\n        gc.collect()\n        tracemalloc.start()\n        check(values)\n        _, peak = tracemalloc.get_traced_memory()\n        tracemalloc.stop()\n        out['cases'].append({'protocol':proto,'kind':label,'samples_ms':samples,'median_ms':statistics.median(samples),'peak_bytes':peak})\nprint(json.dumps(out,indent=2))\n",
